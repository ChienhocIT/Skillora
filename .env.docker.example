# Local-only Docker bundle. Never use these demo defaults for a public deployment.
SKILLORA_DOCKER_PROJECT=skillora-local
SKILLORA_IMAGE_TAG=local
SKILLORA_HTTP_PORT=18080
SKILLORA_MAIL_PORT=18025
SKILLORA_DB_PASSWORD=local-skillora-db
SKILLORA_DB_ROOT_PASSWORD=local-skillora-root
SKILLORA_JWT_SECRET=skillora-local-docker-secret-at-least-32-bytes
SKILLORA_SEED_PASSWORD=Skillora@12345
SKILLORA_BUILD_REVISION=working-tree
